# Environment Variables for red-tide-algal-bloom-monitoring
# Copy this file to .env and fill in your values

# LLM Configuration
RED_TIDE_SKILL_LLM_MODEL_DEFAULT=claude-sonnet-4-6
RED_TIDE_SKILL_LLM_MODEL_FALLBACK=claude-haiku-4-5
RED_TIDE_SKILL_LLM_TEMPERATURE=0.7

# Logging
RED_TIDE_SKILL_LOGGING_LEVEL=INFO

# Data Source API Keys
COP_MARINE_API_KEY=
NOAA_API_KEY=
SEM_SCHOLAR_API_KEY=

# Feature Flags
RED_TIDE_SKILL_FEATURES_ENABLE_ML_PREDICTIONS=true
RED_TIDE_SKILL_FEATURES_ENABLE_SATELLITE_IMAGERY=true
RED_TIDE_SKILL_FEATURES_ENABLE_ALERT_SYSTEM=true
RED_TIDE_SKILL_FEATURES_ENABLE_MULTI_LANGUAGE=true

# Security
RED_TIDE_SKILL_SECURITY_ENCRYPT_SENSITIVE_DATA=true
RED_TIDE_SKILL_SECURITY_AUDIT_LOGGING=true
RED_TIDE_SKILL_SECURITY_RATE_LIMIT_RPM=60
