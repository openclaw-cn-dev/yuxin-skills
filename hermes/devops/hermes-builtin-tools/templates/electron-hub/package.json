{
  "name": "hermes-desktop",
  "version": "0.1.0",
  "description": "Hermes Agent 桌面 UI - 调小弟本尊",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win --x64",
    "pack": "electron-builder --dir"
  },
  "author": "华哥",
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.huage.hermes-desktop",
    "productName": "Hermes 桌面",
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": ["zh_CN"],
      "createDesktopShortcut": true
    }
  }
}
